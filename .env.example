# Copy to .env (or .env.local) and edit. Never commit real values.

# The backend API root, including /api. Required for production builds:
# a build without it fails on purpose. For local development it defaults to
# http://localhost:6700/api (the backend from open-care-backend's docker compose).
NEXT_PUBLIC_API_BASE_URL=http://localhost:6700/api

# How many proxies (nginx, a load balancer) sit in front of this server and append to X-Forwarded-For. Only the entry
# they add is believed as the caller's address (the rate limits depend on it); the entries before it are written by the
# browser. Default 1. Use 0 when nothing is in front: no address is then passed on.
TRUSTED_PROXY_HOPS=1

# The public address of the web app, used for the sitemap and absolute links.
# Optional; see src/lib/site.ts for the default.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sign in with Google (server-side only, optional). Google sign-in goes through Keycloak: set the address and realm
# of the same Keycloak the backend uses. Without them the "Continue with Google" button explains it is unavailable.
# The Keycloak client below must be a public client with Standard flow on and PKCE (S256), and must list
# <your site>/auth/google/callback as a valid redirect URI. See the README, "Sign in with Google".
# KEYCLOAK_URL=https://keycloak.example.com
# KEYCLOAK_REALM=opencare
# KEYCLOAK_CLIENT_ID=open-care-frontend

# Local development only, in .env.local (git-ignored): demo accounts for the dev login helper,
# a JSON array. Seeded from open-care-backend/platform/realm-export.json. Never set this in production.
# DEV_LOGIN_ACCOUNTS=[{"username":"doctor","password":"<local demo password>"}]
